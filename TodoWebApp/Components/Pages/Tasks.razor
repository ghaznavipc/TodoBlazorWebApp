@page "/tasks"
@rendermode InteractiveServer

@inject NavigationManager navigationManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<h3>Tasks</h3>


@if (TodoItems is null)
{
    <h2>loading...</h2>
}
else if (TodoItems.Count == 0)
{
    <h2>No tasks found.</h2>
}
else
{
    @foreach (var task in TodoItems)
    {
        <div class="input-group mt-3">
            <div class="input-group-text">
                <input @bind="task.IsDone" class="form-check-input mt-0" type="checkbox" />
            </div>
            <input @bind="task.Title" class="form-control @(task.IsDone ? "text-decoration-line-through" : "")" />
            <input class="btn btn-outline-light" type="button" value="❌" />
        </div>
    }
    <button class="mt-3 btn btn-outline-light">➕</button>
}

@code {
    [PersistentState]
    public List<TodoItem>? TodoItems { get; set; }

        protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        TodoItems = await db.TodoItems.ToListAsync();
    }
}
